# Public endpoints
APP_DOMAIN=meet.example.com
RTC_DOMAIN=rtc.example.com
LETSENCRYPT_EMAIL=ops@example.com
DEPLOY_REGION=eu-central-1

# Core app
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_URL=https://meet.example.com
NEXTAUTH_URL=https://meet.example.com
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/zstream

# App observability
METRICS_ACCESS_TOKEN=replace_with_a_metrics_bearer_token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Demo fallback user
DEMO_USER_EMAIL=demo@zstream.app
DEMO_USER_PASSWORD=Demo1234
DEMO_USER_NAME=ZSTREAM Demo

# Cache
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300

# LiveKit production
SFU_PROVIDER=livekit
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_ROOM_MAX_PARTICIPANTS=150
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_NODE_IP=

# Optional operator overrides
PROMETHEUS_RETENTION_TIME=15d
