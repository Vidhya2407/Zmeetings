# Core app
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# Current repository datastore (Mongo-backed repositories)
MONGODB_URI=mongodb://localhost:27017/zstream

# Demo fallback user
DEMO_USER_EMAIL=demo@zstream.app
DEMO_USER_PASSWORD=Demo1234
DEMO_USER_NAME=ZSTREAM Demo

# Cache
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300

# SFU (Phase 2 - LiveKit)
SFU_PROVIDER=none
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Meeting network risk gate (VPN/proxy/TOR detection)
# Set NETWORK_RISK_ENFORCEMENT=block to prevent meeting entry when a provider flags risk.
# Without IPINFO_TOKEN or IPQUALITYSCORE_API_KEY the app allows entry but marks the check unverified.
NETWORK_RISK_ENFORCEMENT=block
IPINFO_TOKEN=
IPQUALITYSCORE_API_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=replace_with_stripe_secret_if_used

# Free-first stack endpoints (for migration and infra baseline)
POSTGRES_URL=postgresql://zmeetings:zmeetings@localhost:5432/zmeetings
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
POSTGRES_DB=zmeetings
POSTGRES_USER=zmeetings
POSTGRES_PASSWORD=zmeetings
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
