# Copy to `.env` before running `docker compose up --build`

AUTH_SECRET=replace_with_a_long_random_secret
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# App currently reads Mongo-backed repositories.
MONGODB_URI=mongodb://mongo:27017/zstream

CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300

# SFU (LiveKit)
SFU_PROVIDER=none
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PostgreSQL/Redis/MinIO baseline services
POSTGRES_URL=postgresql://zmeetings:zmeetings@postgres:5432/zmeetings
POSTGRES_DB=zmeetings
POSTGRES_USER=zmeetings
POSTGRES_PASSWORD=zmeetings
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
